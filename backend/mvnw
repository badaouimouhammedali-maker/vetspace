#!/bin/sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MVN_DIR="$BASE_DIR/.mvn/apache-maven"
MVN_VERSION="3.9.9"
MVN_DIST="apache-maven-$MVN_VERSION-bin.tar.gz"
MVN_URL="https://archive.apache.org/dist/maven/maven-3/$MVN_VERSION/binaries/$MVN_DIST"

if ! command -v mvn >/dev/null 2>&1; then
  if [ ! -x "$MVN_DIR/bin/mvn" ]; then
    echo "Bootstrapping Maven $MVN_VERSION into $MVN_DIR" >&2
    mkdir -p "$MVN_DIR"
    curl -fsSL "$MVN_URL" -o "$BASE_DIR/.mvn/$MVN_DIST"
    tar -xzf "$BASE_DIR/.mvn/$MVN_DIST" -C "$MVN_DIR" --strip-components=1
    rm -f "$BASE_DIR/.mvn/$MVN_DIST"
  fi
  export PATH="$MVN_DIR/bin:$PATH"
fi

exec mvn "$@"

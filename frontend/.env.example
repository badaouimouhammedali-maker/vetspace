# Empty in dev: the Vite proxy forwards /api to localhost:8080.
VITE_API_URL=
# Google reCAPTCHA v2 site key. Empty = widget hidden, dummy token sent
# (backend must run with RECAPTCHA_ENABLED=false, as in the dev profile).
VITE_RECAPTCHA_SITE_KEY=

# Origin of the API itself, used ONLY for multipart uploads (admin media + study
# resources). Everything else goes through the same-origin /api proxy so the refresh
# cookie stays first-party. This exists because the Vercel edge caps request bodies at
# roughly 4.5MB, which a 25MB polycopie exceeds. Leave EMPTY in dev and in the
# containerised stack — they are same-origin already and need no bypass.
# Production example: https://vetspace-api.up.railway.app
VITE_API_DIRECT_URL=

# Le mode sombre est incomplet (14 classes `dark:` seulement, état non persisté) : le
# basculement est masqué par défaut. Mettre à "true" pour le retrouver en local le jour
# où quelqu'un fera la vraie passe.
VITE_ENABLE_DARK_MODE=

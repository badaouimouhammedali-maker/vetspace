DB_NAME=vetspace
DB_USER=vetspace
DB_PASSWORD=vetspace
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@vetspace.local
MAIL_MODE=log
MEDIA_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=vetspace
MEDIA_ACCESS_KEY=minioadmin
MEDIA_SECRET_KEY=minioadmin
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/vetspace
RECAPTCHA_SECRET=
RECAPTCHA_ENABLED=true
DEMO_QUESTION_LIMIT=10
SUPPORT_INBOX=support@vetspace.local
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
# One-shot first-admin bootstrap on an empty database. Set to true for a single
# deploy, then delete this and ADMIN_PASSWORD. See docs/deploy.md.
SEED_ADMIN=false
# Refresh-cookie attributes. Strict is right when the SPA and API share an
# origin; a split deploy (Vercel + Railway) needs None, which application-prod.yml
# sets on its own. Only override here if you know why.
COOKIE_SAME_SITE=Strict
COOKIE_SECURE=true
